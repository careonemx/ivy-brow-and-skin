---
import Base from '../layouts/Base.astro';
import Ico from '../components/Ico.astro';
import { business, waLink } from '../data/business';
---

<Base titulo="Página no encontrada | Ivy Brow & Skin" descripcion="Esta página no existe. Vuelve al inicio o agenda tu cita." ruta="/404" noindex>
  <section class="seccion">
    <div class="contenedor lectura">
      <h1>Esta página no existe</h1>
      <p class="bajada">Puede que el enlace esté mal escrito o que la página haya cambiado de lugar.</p>
      <div class="acciones">
        <a class="btn btn--lleno" href="/">Ir al inicio</a>
        <a class="btn btn--borde" href="/servicios">Ver servicios</a>
        <a class="btn btn--borde" href={waLink()} target="_blank" rel="noopener" data-ubicacion="404"><Ico n="whatsapp" /> WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: var(--t-5);
  }
  .bajada {
    font-size: var(--t-2);
    color: var(--suave);
    margin-bottom: 2rem;
  }
</style>
