---
/**
 * Ilustración de la portada: el diseño de una ceja, como se hace en la cita.
 * Primero aparecen las líneas de medición (inicio, arco, final) y después
 * los pelos se trazan uno por uno, en la dirección en que crece el pelo real.
 *
 * Los trazos se generan aquí con una semilla fija: el dibujo es siempre el
 * mismo en cada build. Es la única animación automática del sitio, y con
 * `prefers-reduced-motion` se muestra ya terminada.
 */
interface Props {
  animar?: boolean;
}
const { animar = true } = Astro.props;

// Generador pseudoaleatorio con semilla fija (mulberry32)
let s = 20261111;
const rnd = () => {
  s |= 0;
  s = (s + 0x6d2b79f5) | 0;
  let t = Math.imul(s ^ (s >>> 15), 1 | s);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

// Geometría de la ceja (viewBox 560 × 240). t va de 0 (inicio) a 1 (final).
const X0 = 50;
const LARGO = 450;
// borde inferior: sube suave y cae en la cola
const inferior = (t: number) => 182 - 46 * Math.sin((Math.PI * Math.min(t, 1)) / 1.32);
// grosor: lleno al inicio, se mantiene en el cuerpo y se afila en la cola
const grosor = (t: number) => 6 + 58 * Math.pow(1 - t, 0.55) * (t < 0.08 ? 0.82 + t * 2.2 : 1);
const superior = (t: number) => inferior(t) - grosor(t) - 22 * Math.sin(Math.PI * Math.min(t / 0.62, 1) * 0.5) * (t < 0.62 ? 1 : Math.max(0, 1 - (t - 0.62) * 2.6));
const tangente = (t: number) => {
  const e = 0.004;
  const m = (u: number) => (inferior(u) + superior(u)) / 2;
  return Math.atan2(m(t + e) - m(t - e), LARGO * 2 * e);
};

const N = 170;
const pelos = Array.from({ length: N }, (_, i) => {
  const t = Math.min(0.985, Math.pow((i + rnd()) / N, 1.12));
  const arriba = superior(t);
  const abajo = inferior(t);
  const v = rnd(); // 0 = borde superior, 1 = borde inferior
  const x = X0 + LARGO * t + (rnd() - 0.5) * 5;
  const y = arriba + v * (abajo - arriba) * 0.92;
  const base = tangente(t);
  let ang: number;
  let L = 20 + rnd() * 14;
  if (t < 0.12) {
    // inicio: pelos hacia arriba, ligeramente hacia la cola
    ang = -Math.PI / 2 + 0.25 + t * 3 + rnd() * 0.25;
    L *= 0.9;
  } else if (t > 0.78) {
    // cola: todos siguen la dirección de la ceja
    ang = base + (rnd() - 0.5) * 0.18;
    L *= 0.85;
  } else {
    // cuerpo: abajo suben en abanico, arriba bajan; se cruzan en el centro
    ang = base + (0.28 - v * 0.95) + (rnd() - 0.5) * 0.16;
  }
  const x2 = x + Math.cos(ang) * L;
  const y2 = y + Math.sin(ang) * L;
  const c = (0.1 + rnd() * 0.12) * L;
  const mx = (x + x2) / 2 - Math.sin(ang) * c;
  const my = (y + y2) / 2 + Math.cos(ang) * c;
  return {
    d: `M${x.toFixed(1)} ${y.toFixed(1)}Q${mx.toFixed(1)} ${my.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`,
    w: (1.1 + rnd() * 0.9).toFixed(2),
    o: (0.62 + rnd() * 0.38).toFixed(2),
    delay: (0.9 + t * 1.6 + rnd() * 0.25).toFixed(2),
  };
});

const inicioX = X0 + 2;
const arcoX = X0 + LARGO * 0.62;
const finalX = X0 + LARGO;
---

<figure class="ceja" data-animar={animar ? '' : undefined}>
  <svg viewBox="0 0 560 240" role="img" aria-labelledby="ceja-titulo">
    <title id="ceja-titulo">Diseño de una ceja: líneas de medición y pelos trazados uno por uno</title>
    <g class="ceja__medidas" stroke-width="1" fill="none">
      <line x1={inicioX} y1="18" x2={inicioX} y2="222" pathLength="1" />
      <line x1={arcoX} y1="18" x2={arcoX} y2="222" pathLength="1" />
      <line x1={finalX} y1="18" x2={finalX} y2="222" pathLength="1" />
      <line x1="24" y1={superior(0.62) - 10} x2="536" y2={superior(0.62) - 10} pathLength="1" />
    </g>
    <g class="ceja__rotulos">
      <text x={inicioX + 6} y="30">inicio</text>
      <text x={arcoX + 6} y="30">arco</text>
      <text x={finalX - 6} y="30" text-anchor="end">final</text>
    </g>
    <g class="ceja__pelos" fill="none" stroke-linecap="round">
      {pelos.map((p) => (
        <path d={p.d} stroke-width={p.w} opacity={p.o} pathLength="1" style={`--d:${p.delay}s`} />
      ))}
    </g>
  </svg>
  <figcaption>Cada pelo se traza en la dirección en que crece el tuyo.</figcaption>
</figure>

<style>
  .ceja {
    margin: 0;
  }
  .ceja svg {
    width: 100%;
    overflow: visible;
  }
  .ceja__medidas {
    stroke: var(--salvia);
    stroke-dasharray: 0.012 0.012;
  }
  .ceja__rotulos {
    font-family: var(--texto);
    font-size: 13px;
    fill: var(--salvia-texto);
    letter-spacing: 0.02em;
  }
  .ceja__pelos {
    stroke: var(--vino);
  }
  .ceja figcaption {
    margin-top: 0.75rem;
    font-size: var(--t-0);
    color: var(--suave);
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ceja[data-animar] .ceja__medidas line {
      animation: aparecer 0.9s var(--ease) both;
    }
    .ceja[data-animar] .ceja__medidas line:nth-child(2) {
      animation-delay: 0.15s;
    }
    .ceja[data-animar] .ceja__medidas line:nth-child(3) {
      animation-delay: 0.3s;
    }
    .ceja[data-animar] .ceja__medidas line:nth-child(4) {
      animation-delay: 0.45s;
    }
    .ceja[data-animar] .ceja__rotulos {
      animation: aparecer 0.6s 0.5s var(--ease) both;
    }
    .ceja[data-animar] .ceja__pelos path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: trazar 0.38s var(--d) var(--ease) forwards;
    }
  }
  @keyframes trazar {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
</style>
